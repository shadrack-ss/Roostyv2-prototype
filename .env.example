# --- Database ---------------------------------------------------------------
# PostgreSQL connection string. `docker compose up -d` starts a matching local
# database on port 5434 with the credentials below.
DATABASE_URL="postgresql://haven:haven@localhost:5434/haven_homes?sslmode=disable"

# --- Admin sign-in ------------------------------------------------------------
# Signing secret for admin sessions. Generate one with: npx auth secret
AUTH_SECRET=""
# The first admin account `npm run db:seed` creates. Change the password after
# signing in for the first time (Admin > Profile).
ADMIN_EMAIL="admin@havenhomes.example"
ADMIN_PASSWORD=""

# --- Email (optional) ---------------------------------------------------------
# Booking and contact notifications. Leave SMTP_PASSWORD empty to turn email
# off; requests are still saved and shown in the admin inbox.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASSWORD=""
# Where notifications go when "Send alerts to" is empty in Site settings.
NOTIFY_TO=""
MAIL_FROM_NAME="Haven Homes"

# --- Image uploads (optional) -------------------------------------------------
# Vercel Blob token. Unset = uploads are saved to public/uploads on this server.
BLOB_READ_WRITE_TOKEN=""
