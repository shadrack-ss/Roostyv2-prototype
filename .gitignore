# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Reference material, not part of the app.
# HTTrack mirrors kept locally for design/copy reference while rebuilding:
#   montana/ - the Colorlib "Montana"/Roberto template preview
#   roosts/  - the legacy roostyshomes.com WordPress site (~59MB)
# Nothing in app/ imports from these.
/montana/
/roosts/

# HTTrack scrape artifacts, in case another mirror is added at the root
hts-cache/
hts-log.txt
backblue.gif
fade.gif

# editor / local tool settings
/.vscode/
.claude/settings.local.json

# generated Prisma client (rebuilt by `npm install` via postinstall)
/generated/

# admin uploads stored on local disk in development
/public/uploads/
!.env.example
